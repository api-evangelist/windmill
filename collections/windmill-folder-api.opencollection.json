{
  "opencollection": "1.0.0",
  "info": {
    "name": "Windmill admin folder API",
    "version": "1.694.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "folder",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Folders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/folders/list",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "which page to return (start at 1, default 1)"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "number of items to return for a given page (default 30, max 100)"
              }
            ]
          },
          "docs": "List Folders"
        },
        {
          "info": {
            "name": "List Folder Names",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/folders/listnames",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "only_member_of",
                "value": "",
                "type": "query",
                "description": "only list the folders the user is member of (default false)"
              }
            ]
          },
          "docs": "List Folder Names"
        },
        {
          "info": {
            "name": "Create Folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/w/:workspace/folders/create",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Folder"
        },
        {
          "info": {
            "name": "Update Folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/w/:workspace/folders/update/:name",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Folder"
        },
        {
          "info": {
            "name": "Delete Folder",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/api/w/:workspace/folders/delete/:name",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Folder"
        },
        {
          "info": {
            "name": "Get Folder",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/folders/get/:name",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Folder"
        },
        {
          "info": {
            "name": "Exists Folder",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/folders/exists/:name",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Exists Folder"
        },
        {
          "info": {
            "name": "Get Folder Usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/folders/getusage/:name",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Folder Usage"
        },
        {
          "info": {
            "name": "Add Owner to Folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/w/:workspace/folders/addowner/:name",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add Owner to Folder"
        },
        {
          "info": {
            "name": "Remove Owner to Folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/w/:workspace/folders/removeowner/:name",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Remove Owner to Folder"
        },
        {
          "info": {
            "name": "Get Folder Permission History",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/folders_history/get/:name",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "which page to return (start at 1, default 1)"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "number of items to return for a given page (default 30, max 100)"
              }
            ]
          },
          "docs": "Get Folder Permission History"
        }
      ]
    }
  ],
  "bundled": true
}