{
  "opencollection": "1.0.0",
  "info": {
    "name": "Windmill admin variable API",
    "version": "1.694.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "variable",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Variable",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/w/:workspace/variables/create",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "already_encrypted",
                "value": "",
                "type": "query",
                "description": "whether the variable is already encrypted (default false)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Variable"
        },
        {
          "info": {
            "name": "Encrypt Value",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/w/:workspace/variables/encrypt",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Encrypt Value"
        },
        {
          "info": {
            "name": "Delete Variable",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/api/w/:workspace/variables/delete/:path",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "path",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Variable"
        },
        {
          "info": {
            "name": "Delete Variables in Bulk",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/api/w/:workspace/variables/delete_bulk",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete Variables in Bulk"
        },
        {
          "info": {
            "name": "Update Variable",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/w/:workspace/variables/update/:path",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "path",
                "value": "",
                "type": "path"
              },
              {
                "name": "already_encrypted",
                "value": "",
                "type": "query",
                "description": "whether the variable is already encrypted (default false)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Variable"
        },
        {
          "info": {
            "name": "Get Variable",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/variables/get/:path",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "path",
                "value": "",
                "type": "path"
              },
              {
                "name": "decrypt_secret",
                "value": "",
                "type": "query",
                "description": "ask to decrypt secret if this variable is secret\n(if not secret no effect, default: true)\n"
              },
              {
                "name": "include_encrypted",
                "value": "",
                "type": "query",
                "description": "ask to include the encrypted value if secret and decrypt secret is not true (default: false)\n"
              }
            ]
          },
          "docs": "Get Variable"
        },
        {
          "info": {
            "name": "Get Variable Value",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/variables/get_value/:path",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "path",
                "value": "",
                "type": "path"
              },
              {
                "name": "allow_cache",
                "value": "",
                "type": "query",
                "description": "allow getting a cached value for improved performance\n"
              }
            ]
          },
          "docs": "Get Variable Value"
        },
        {
          "info": {
            "name": "Does Variable Exists at Path",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/variables/exists/:path",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "path",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Does Variable Exists at Path"
        },
        {
          "info": {
            "name": "List Variables",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/variables/list",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "path_start",
                "value": "",
                "type": "query",
                "description": "filter variables by path prefix"
              },
              {
                "name": "path",
                "value": "",
                "type": "query",
                "description": "exact path match filter"
              },
              {
                "name": "description",
                "value": "",
                "type": "query",
                "description": "pattern match filter for description field (case-insensitive)"
              },
              {
                "name": "value",
                "value": "",
                "type": "query",
                "description": "pattern match filter for non-secret variable values (case-insensitive)"
              },
              {
                "name": "broad_filter",
                "value": "",
                "type": "query",
                "description": "broad search across multiple fields (case-insensitive substring match)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "which page to return (start at 1, default 1)"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "number of items to return for a given page (default 30, max 100)"
              },
              {
                "name": "label",
                "value": "",
                "type": "query",
                "description": "Filter by label"
              }
            ]
          },
          "docs": "List Variables"
        },
        {
          "info": {
            "name": "List Contextual Variables",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/variables/list_contextual",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Contextual Variables"
        }
      ]
    }
  ],
  "bundled": true
}