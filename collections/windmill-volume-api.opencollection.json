{
  "opencollection": "1.0.0",
  "info": {
    "name": "Windmill admin volume API",
    "version": "1.694.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "volume",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List All Volumes in the Workspace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/volumes/list",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List All Volumes in the Workspace"
        },
        {
          "info": {
            "name": "Get the Volume Storage Name (secondary Storage) or Null for Primary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/volumes/storage",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get the Volume Storage Name (secondary Storage) or Null for Primary"
        },
        {
          "info": {
            "name": "Create a New Volume",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/w/:workspace/volumes/create",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a New Volume"
        },
        {
          "info": {
            "name": "Delete a Volume (admin Only)",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/api/w/:workspace/volumes/delete/:name",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a Volume (admin Only)"
        }
      ]
    }
  ],
  "bundled": true
}