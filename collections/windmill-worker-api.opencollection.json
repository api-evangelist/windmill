{
  "opencollection": "1.0.0",
  "info": {
    "name": "Windmill admin worker API",
    "version": "1.694.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "worker",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Instance Custom Tags (tags are Used to Dispatch Jobs to different worker groups)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/workers/custom_tags",
            "params": [
              {
                "name": "show_workspace_restriction",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get All Instance Custom Tags (tags are Used to Dispatch Jobs to different worker groups)"
        },
        {
          "info": {
            "name": "Get Custom Tags Available for this Workspace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/workers/custom_tags",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Custom Tags Available for this Workspace"
        },
        {
          "info": {
            "name": "Get All Instance Default Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/workers/get_default_tags"
          },
          "docs": "Get All Instance Default Tags"
        },
        {
          "info": {
            "name": "Is Default Tags Per Workspace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/workers/is_default_tags_per_workspace"
          },
          "docs": "Is Default Tags Per Workspace"
        },
        {
          "info": {
            "name": "List Workers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/workers/list",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "which page to return (start at 1, default 1)"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "number of items to return for a given page (default 30, max 100)"
              },
              {
                "name": "ping_since",
                "value": "",
                "type": "query",
                "description": "number of seconds the worker must have had a last ping more recent of (default to 300)"
              }
            ]
          },
          "docs": "List Workers"
        },
        {
          "info": {
            "name": "Exists Workers with Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/workers/exists_workers_with_tags",
            "params": [
              {
                "name": "tags",
                "value": "",
                "type": "query",
                "description": "comma separated list of tags"
              },
              {
                "name": "workspace",
                "value": "",
                "type": "query",
                "description": "workspace to filter tags visibility (required when TAGS_ARE_SENSITIVE is enabled for non-superadmins)"
              }
            ]
          },
          "docs": "Exists Workers with Tags"
        },
        {
          "info": {
            "name": "Get Queue Metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/workers/queue_metrics"
          },
          "docs": "Get Queue Metrics"
        },
        {
          "info": {
            "name": "Get Counts of Jobs Waiting for an Executor Per Tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/workers/queue_counts"
          },
          "docs": "Get Counts of Jobs Waiting for an Executor Per Tag"
        },
        {
          "info": {
            "name": "Get Counts of Currently Running Jobs Per Tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/workers/queue_running_counts"
          },
          "docs": "Get Counts of Currently Running Jobs Per Tag"
        }
      ]
    }
  ],
  "bundled": true
}