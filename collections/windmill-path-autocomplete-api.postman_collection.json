          "id": "d98d7429-3378-470d-bfcb-67857010bc4c",
          "name": "List All Paths in a Workspace for Client-side Autocomplete",
          "request": {
            "name": "List All Paths in a Workspace for Client-side Autocomplete",
            "description": {
              "content": "Returns the flat list of all item paths visible to the caller across\nscripts, flows, apps, raw apps, variables, and resources. Intended to\nfeed an entirely client-side path autocomplete UI: the frontend fetches\nonce (server caches per workspace for 60s) and performs all prefix/segment\ncomputation locally. Capped at 20,000 paths (5,000 per table).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "w",
                ":workspace",
                "path_autocomplete",
                "list_paths"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspace",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "12c3e11e-0fc0-4fcf-b442-df2cfc7a7f77",
              "name": "deduplicated path list, sorted lexicographically",
              "originalRequest": {
                "url": {
                  "path": [
