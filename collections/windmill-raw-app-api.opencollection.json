{
  "opencollection": "1.0.0",
  "info": {
    "name": "Windmill admin raw_app API",
    "version": "1.694.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "raw_app",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List All Raw Apps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/w/:workspace/raw_apps/list",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "which page to return (start at 1, default 1)"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "number of items to return for a given page (default 30, max 100)"
              },
              {
                "name": "order_desc",
                "value": "",
                "type": "query",
                "description": "order by desc order (default true)"
              },
              {
                "name": "created_by",
                "value": "",
                "type": "query",
                "description": "filter by exact matching user creator. Supports comma-separated list (e.g. 'alice,bob') and negation by prefixing all values with '!' (e.g. '!alice,!bob')"
              },
              {
                "name": "path_start",
                "value": "",
                "type": "query",
                "description": "mask to filter matching starting path"
              },
              {
                "name": "path_exact",
                "value": "",
                "type": "query",
                "description": "mask to filter exact matching path"
              },
              {
                "name": "starred_only",
                "value": "",
                "type": "query",
                "description": "(default false)\nshow only the starred items\n"
              },
              {
                "name": "label",
                "value": "",
                "type": "query",
                "description": "Filter by label"
              }
            ]
          },
          "docs": "List All Raw Apps"
        }
      ]
    }
  ],
  "bundled": true
}