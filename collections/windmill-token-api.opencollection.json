{
  "opencollection": "1.0.0",
  "info": {
    "name": "Windmill admin token API",
    "version": "1.694.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List of Available Scopes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/tokens/list/scopes"
          },
          "docs": "List of Available Scopes"
        }
      ]
    }
  ],
  "bundled": true
}